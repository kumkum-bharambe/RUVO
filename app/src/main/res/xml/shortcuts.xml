<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="add" android:enabled="true" android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.ruvo.app" android:targetClass="com.ruvo.app.MainActivity">
            <extra android:name="com.ruvo.extra.OPEN" android:value="quickadd" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="ask" android:enabled="true" android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_ask">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.ruvo.app" android:targetClass="com.ruvo.app.MainActivity">
            <extra android:name="com.ruvo.extra.OPEN" android:value="chat" />
        </intent>
    </shortcut>
</shortcuts>
