    <path android:fillColor="#40FFC23D" android:pathData="M34.9,57.3A19.1,19.1 0 0,1 73.1,57.3Z"/>
    <!-- The half sun, sitting on the horizon. -->
    <path android:fillColor="#FFC23D" android:pathData="M40.8,57.3A13.2,13.2 0 0,1 67.2,57.3Z"/>
    <!-- Horizon line. -->
    <path android:strokeColor="#FF8A45" android:strokeWidth="1.5" android:strokeLineCap="round" android:pathData="M34.2,57.3L73.8,57.3"/>
